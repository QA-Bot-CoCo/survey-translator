# Configure these in Vercel. Never copy the old repository's .env or tokens.
APP_ORIGIN=https://your-survey-app.vercel.app
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Single-tenant Microsoft Entra web application. Callback: APP_ORIGIN/auth/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated Microsoft Entra user OBJECT IDs, not email addresses.
ALLOWED_USER_IDS=
# Dedicated private Upstash Redis database, preferably in an approved EU region.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A fresh project-scoped API key. Enforce project usage controls separately.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Hard application limits. Failed/ambiguous requests also consume these quotas.
USER_DAILY_JOBS=10
GLOBAL_DAILY_JOBS=100
USER_DAILY_BATCHES=200
GLOBAL_DAILY_BATCHES=1000
